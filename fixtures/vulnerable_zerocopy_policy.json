{
  "policy_name": "vulnerable_legacy_copy_policy",
  "iommu_smmu_isolation_enabled": false,
  "allow_unrestricted_physical_dma": true,
  "hardware_sync_fence_enforced": false,
  "allow_concurrent_dma_write_during_infer": true,
  "verify_trt_engine_signature": false,
  "allow_untrusted_trt_plugins": true,
  "dmabuf_fd_cloexec_enforced": false,
  "dmabuf_pool_slots": 2,
  "pitch_alignment_bytes": 64,
  "page_alignment_bytes": 1024,
  "strict_plane_bounds_check": false,
  "zero_copy_dmabuf_enabled": false,
  "allow_cpu_memcpy_fallback": true,
  "zeroize_dmabuf_on_free": false,
  "dma_heap_permissions_octal": "0666",
  "csi_frame_timeout_ms": 250,
  "verify_monotonic_v4l2_sequence": false,
  "preallocate_trt_execution_context": false,
  "mlock_dma_pool_buffers": false,
  "log_e2e_latency_telemetry": false,
  "verify_jetson_clocks_locked": false
}
