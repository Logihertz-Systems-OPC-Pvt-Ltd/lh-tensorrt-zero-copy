{
  "policy_name": "hardened_jetson_orin_zerocopy",
  "iommu_smmu_isolation_enabled": true,
  "allow_unrestricted_physical_dma": false,
  "hardware_sync_fence_enforced": true,
  "allow_concurrent_dma_write_during_infer": false,
  "verify_trt_engine_signature": true,
  "allow_untrusted_trt_plugins": false,
  "dmabuf_fd_cloexec_enforced": true,
  "dmabuf_pool_slots": 4,
  "pitch_alignment_bytes": 256,
  "page_alignment_bytes": 4096,
  "strict_plane_bounds_check": true,
  "zero_copy_dmabuf_enabled": true,
  "allow_cpu_memcpy_fallback": false,
  "zeroize_dmabuf_on_free": true,
  "dma_heap_permissions_octal": "0600",
  "csi_frame_timeout_ms": 50,
  "verify_monotonic_v4l2_sequence": true,
  "preallocate_trt_execution_context": true,
  "mlock_dma_pool_buffers": true,
  "log_e2e_latency_telemetry": true,
  "verify_jetson_clocks_locked": true
}
